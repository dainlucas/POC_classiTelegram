# Chave de API da TypeSafe para o JEV AI
# Obtenha sua chave em: https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Modo Telegram Bot (Recomendado)
# Crie seu bot no @BotFather no Telegram para obter o token
TELEGRAM_BOT_TOKEN=

# Resposta automática no grupo (true/false)
# Se true, o bot responde a cada mensagem com a etiqueta da categoria identificada
REPLY_IN_GROUP=false

# (Opcional) Modo Telegram Usuário / Telethon
# Use caso queira ouvir grupos onde você é membro mas não tem permissão para adicionar bots
# Obtenha em: https://my.telegram.org (seção API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
